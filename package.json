{
    "name": "@donneko/window-system",
    "version": "0.2.0-beta.0",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./window-style.css": "./dist/window-style.css"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist/",
        "docs/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test vitest.config.ts",
        "format:check": "prettier --check src test vitest.config.ts index.html demo-content.html",
        "build": "npm run clean && tsc && npm run copy:assets",
        "copy:assets": "node -e \"require('node:fs').copyFileSync('src/assets/css/window-style.css', 'dist/window-style.css')\"",
        "docs": "typedoc",
        "prepack": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/donneko/window-system.git"
    },
    "type": "module",
    "keywords": [],
    "author": "丼猫",
    "license": "MIT",
    "description": "A window system for web applications.",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.3",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.5",
        "tsx": "^4.22.4",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.12.0",
        "typedoc-vitepress-theme": "^1.1.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0",
        "vitepress": "^1.6.4",
        "vitest": "^4.1.9"
    }
}
